    "./notify": "./src/dsh-butler/lib/notify.mjs",
    "./steward": "./src/dsh-butler/steward.mjs",
    "./stall-nudge": "./src/dsh-butler/stall-nudge.mjs",
    "./failure-classify": "./src/dsh-butler/failure-classify.mjs",
    "./host-config": "./src/lib/host-config.mjs",
    "./repo-superset": "./src/lib/repo-superset.mjs",
    "./peer-channel": "./src/lib/peer-channel.mjs",
    "./handoff": "./src/dsh-butler/handoff.mjs",
    "./cold-handoff": "./src/dsh-butler/cold-handoff.mjs",
    "./text-sync": "./src/dsh-butler/text-sync.mjs",
