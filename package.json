    "butler-failure-classify": "./src/dsh-butler/failure-classify.mjs",
    "butler-progress-status": "./src/dsh-butler/progress-status.mjs",
    "butler-stall-nudge": "./src/dsh-butler/stall-nudge.mjs",
    "butler-handoff": "./src/dsh-butler/handoff.mjs",
    "butler-cold-handoff": "./src/dsh-butler/cold-handoff.mjs",
    "butler-text-sync": "./src/dsh-butler/text-sync.mjs",
    "butler-text-sync-direct": "./src/dsh-butler/text-sync-direct.mjs"
